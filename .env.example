# ---- Server ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ---- Database (PostgreSQL on the clinic server) ----
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=zhanx_dentalcare
DB_USER=zhanx_app
DB_PASSWORD=change-this-db-password
DB_POOL_MAX=10

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-secret
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---- Storage ----
DATA_DIR=./data
UPLOAD_MAX_MB=10
BACKUP_SCHEDULE=0 21 * * *
BACKUP_RETENTION_DAYS=30

# ---- PostgreSQL tools (backup / restore scripts) ----
# Folder that contains pg_dump.exe, pg_restore.exe and psql.exe.
# setup-server.ps1 fills these automatically; set them when PostgreSQL is elsewhere.
PG_BIN_DIR=C:\Program Files\PostgreSQL\16\bin
PG_DUMP_BIN=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
PG_RESTORE_BIN=C:\Program Files\PostgreSQL\16\bin\pg_restore.exe
PG_PSQL_BIN=C:\Program Files\PostgreSQL\16\bin\psql.exe

# ---- Licensing (offline, device-bound) ----
# Public key that verifies signed license files. The default in
# apps/server/src/config/env.js is the ZhanX Studio release key; override only
# when rotating keys or working with a test key. NEVER put the PRIVATE key here.
# ZHANX_LICENSE_PUBLIC_KEY=MCowBQYDK2VwAyEAt1cjGeETFfLaZSjKofXxWh7UDEaarKc5hTT4YJQzgBI=
ZHANX_SUPPORT_EMAIL=support@zhanxstudio.com
# ZHANX_SUPPORT_PHONE=+91 98450 12345

# ---- LAN ----
# Comma separated origins allowed to call the API (desktop client sends no Origin header)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
