# =========================================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================

# ---------------------------------------------------------
# 1. BACKEND (Render / Cloud Server) Environment Variables
# ---------------------------------------------------------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Free Cloud PostgreSQL Database Connection URL
# Choose ANY of the following options:
#
# Option A: Neon.tech (Recommended - 100% Free Forever Serverless Postgres)
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-solitary-river-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# Option B: Supabase (500MB Free Postgres)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.abcdefghijklmnopqrst.supabase.co:5432/postgres?sslmode=require
#
# Option C: Render Free PostgreSQL
# DATABASE_URL=postgresql://zhanx_admin:YOUR_PASSWORD@dpg-xyz-a.singapore-postgres.render.com/zhanx_dentalcare

# Security Secrets (Must be at least 32 characters in production)
JWT_SECRET=zhanx_super_secure_production_jwt_secret_key_2026_tamilan_saas

# Allow your Netlify Frontend URL to call the backend
# Example: https://your-site-name.netlify.app or * for all
CORS_ORIGINS=*

# Backup Schedule (Every day at 9 PM)
BACKUP_SCHEDULE=0 21 * * *

# ---------------------------------------------------------
# 2. FRONTEND (Netlify) Environment Variables
# ---------------------------------------------------------
# Set this in Netlify -> Site configuration -> Environment variables
VITE_API_URL=https://zhanx-dentalcare-server.onrender.com/api
