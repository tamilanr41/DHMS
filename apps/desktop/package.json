{
  "name": "zhanx-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "ZhanX DentalCare desktop client",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "vite build && electron-builder --win nsis",
    "dist:dir": "vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "tailwindcss": "^3.4.17",
    "three": "^0.187.0",
    "vite": "^6.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zhanx.dentalcare",
    "productName": "ZhanX DentalCare",
    "directories": {
      "output": "../../release/client"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../docs",
        "to": "docs"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ZhanX-DentalCare-Setup.${ext}",
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZhanX DentalCare",
      "deleteAppDataOnUninstall": false,
      "include": "installer/client.nsh"
    },
    "electronVersion": "33.4.11",
    "copyright": "Copyright © 2026 ZhanX Studio"
  },
  "author": {
    "name": "ZhanX Studio"
  }
}
